# SkyWalking Agent 配置文件
# 适用于 Spring Cloud 微服务项目

# 服务名称,需要在启动时通过 -Dskywalking.agent.service_name 指定
agent.service_name=${SW_SERVICE_NAME:default-service}

# SkyWalking OAP Server 地址
collector.backend_service=${SW_BACKEND:127.0.0.1:11800}

# 日志级别
logging.level=${SW_LOGGING_LEVEL:INFO}

# 日志文件路径
logging.file_name=${SW_LOGGING_FILE_NAME:skywalking-api.log}

# 日志文件最大大小
logging.max_file_size=${SW_LOGGING_MAX_FILE_SIZE:300}

# 日志文件最大数量
logging.max_history_files=${SW_LOGGING_MAX_HISTORY_FILES:3}

# 插件目录
plugin.mount=${SW_MOUNT_PLUGINS:plugins,activations}

# 是否启用插件
plugin.enable=${SW_PLUGIN_ENABLE:true}

# 采样率,默认为 -1,表示 100% 采样
agent.sample_n_per_3_secs=${SW_SAMPLE_N_PER_3_SECS:-1}

# 是否开启 Agent 主动刷新配置
agent.active_v2_header=${SW_ACTIVE_V2_HEADER:true}

# 是否开启 Agent 主动刷新配置
agent.instance_properties_json=${SW_INSTANCE_PROPERTIES_JSON:}

# 是否开启 SQL 参数收集
plugin.jdbc.trace_sql_parameters=${SW_JDBC_TRACE_SQL_PARAMETERS:false}

# SQL 参数最大长度
plugin.jdbc.sql_parameters_max_length=${SW_JDBC_SQL_PARAMETERS_MAX_LENGTH:512}

# 是否开启 Spring MVC 参数收集
plugin.springmvc.trace_params=${SW_SPRINGMVC_TRACE_PARAMS:true}

# 是否开启 Feign 调用链追踪
plugin.feign.trace_body=${SW_FEIGN_TRACE_BODY:false}

# 是否开启 Gateway 链路追踪
plugin.gateway.trace_body=${SW_GATEWAY_TRACE_BODY:false}

# 忽略的 URL 路径
plugin.tomcat.trace_body=${SW_TOMCAT_TRACE_BODY:false}

# 链路追踪上下文传播方式
plugin.mount=plugins,activations

# 支持的组件
plugin.component_define=component-libraries.yml
